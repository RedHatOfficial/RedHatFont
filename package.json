{
  "name": "@redhat/redhat-font",
  "version": "5.0.0",
  "description": "Red Hat - the open source font for Red Hat",
  "main": "red-hat-font.css",
  "scripts": {
    "minify": "npx csso-cli webfonts-demo/font.css --output webfonts-demo/font.min.css",
    "start": "npm run copy-to-webfonts-dist && npx browser-sync start -s 'webfonts-demo' -f 'webfonts-demo'",
    "copy-to-webfonts-dist": "mkdir -p ./webfonts-demo/dist && cp ./fonts/mono/RedHatMono/webfonts/*-VF.woff2 ./webfonts-demo/dist && cp ./fonts/proportional/{RedHatDisplay,RedHatText}/webfonts/*-VF.woff2 ./webfonts-demo/dist",
    "test": ""
  },
  "keywords": [
    "font",
    "Red",
    "Hat"
  ],
  "author": "",
  "license": "OFL-1.1"
}
